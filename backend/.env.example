# Copy this file to backend/.env and fill in your values.
#
# This project reaches Claude through the Portkey AI gateway.
# Set your Portkey key, the gateway URL, and the model name your course gave you.

PORTKEY_API_KEY=pk-...
# Base URL from the course. A trailing "/v1" is fine — it's normalized automatically.
PORTKEY_BASE_URL=https://api.portkey.ai
# The exact model name your course told you to use.
CHATBOT_MODEL=claude-haiku-4-5

# Portkey routes to Anthropic by default. Only change these if your course said to:
# PORTKEY_PROVIDER=anthropic
# PORTKEY_VIRTUAL_KEY=...     # if you were given a virtual key instead of key-only
# PORTKEY_CONFIG=pc-...       # if you were given a config id

# --- Alternative: call Anthropic directly instead of via Portkey ---
# Leave PORTKEY_API_KEY unset and provide this instead.
# ANTHROPIC_API_KEY=sk-ant-...
